# Copy to .env and fill in for `docker compose up`. Never commit the real .env.

POSTGRES_PASSWORD=
# Exact origin(s), comma-separated, that the Origin header must match on the
# WebSocket upgrade AND on login (challenge + verify). The server also accepts
# this under its newer name MERIDIAN_EDGE_ALLOWED_ORIGINS; set either one. The
# compose files pass the variable below, so keep using it unless you edit them.
MERIDIAN_EDGE_WS_ORIGINS=https://meridian-edge.example
# Optional. Peers trusted to set X-Forwarded-For, so the server logs and rate-
# limits real client addresses instead of the proxy's. Leave unset to accept the
# compose default (the private ranges a Compose network draws from); set it to
# narrow the trust to your actual subnet. Never "*" - that lets any client forge
# its address, and the boot guard refuses it in production.
#MERIDIAN_EDGE_TRUSTED_PROXY_IPS=172.16.0.0/12
# Optional. Which published images `docker compose pull` fetches. CI publishes
# <prefix>-server, -caddy and -proxy (amd64 and arm64) for every commit on main
# that passes its gates. Unset means the newest main build. Pin a commit with
# MERIDIAN_EDGE_TAG=sha-<first 7 hex of its hash>, which is also how you roll
# back, or a release with its version (1.2.3). A fork publishing its own images
# sets the prefix to ghcr.io/<owner>/meridian-edge.
#MERIDIAN_EDGE_IMAGES=ghcr.io/proteus-nell/meridian-edge
#MERIDIAN_EDGE_TAG=latest

# --- Route A (nginx) only ---
# Directory containing fullchain.pem + privkey.pem for the proxy to mount.
# See DEPLOY.md for how to obtain these. Unused on the Caddy routes.
TLS_CERT_DIR=./tls

# --- Route B / C (Caddy) only ---
# Public hostname Caddy serves + auto-provisions TLS for. Also feeds the
# page CSP's connect-src. Must match MERIDIAN_EDGE_WS_ORIGINS' host.
MERIDIAN_EDGE_DOMAIN=chat.example.com
# Required. Contact address for the Let's Encrypt/ZeroSSL account. Caddy will
# not start without one, so Compose refuses to start the stack if it is empty.
ACME_EMAIL=you@example.com
