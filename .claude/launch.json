{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "client",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "client2",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5174,
      "autoPort": true,
      "env": { "PORT": "5174" }
    },
    {
      "name": "client3",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "client", "run", "dev"],
      "port": 5175,
      "autoPort": true,
      "env": { "PORT": "5175" }
    },
    {
      "name": "server",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m", "uvicorn", "app.main:create_app", "--factory", "--reload",
        "--app-dir", "server", "--port", "8000"
      ],
      "port": 8000,
      "env": { "MERIDIAN_EDGE_DEV": "1" }
    }
  ]
}
