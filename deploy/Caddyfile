# Caddy edge config (alternative to deploy/nginx.conf): automatic HTTPS via
# Let's Encrypt or ZeroSSL, no certbot. Caddy 2.9+ (Go 1.24) negotiates the
# X25519MLKEM768 hybrid TLS group by default, so the PQ transport handshake
# comes for free with no OpenSSL wrangling.
#
# Drives everything off two env vars (see docker-compose.caddy.yml / .env):
#   MERIDIAN_EDGE_DOMAIN  - the public hostname, e.g. chat.example.com
#   ACME_EMAIL            - optional contact for the ACME account
#
# The security-header set mirrors deploy/nginx.conf exactly: the
# page-level CSP is scoped to the static bundle; the FastAPI backend keeps its
# own stricter JSON CSP (app/headers.py), which passes through untouched.

{
	email {$ACME_EMAIL}
}

# The page-level security header set, in a snippet because two routes now need
# it: the static bundle and the 404 page. Writing it twice would put two copies
# of the CSP in this file - free to drift, and only the first of them is the one
# scripts/audit.py compares against nginx.conf and vite.config.ts.
(static_headers) {
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' wss://{$MERIDIAN_EDGE_DOMAIN}; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		Permissions-Policy "accelerometer=(), camera=(), geolocation=(), microphone=(), payment=(), usb=()"
	}
}

{$MERIDIAN_EDGE_DOMAIN} {
	encode gzip

	# TLS 1.3 only, matching nginx.conf's `ssl_protocols TLSv1.3`. Without this,
	# Caddy allows TLS 1.2, which drops to a classical cipher and, more to the
	# point, never negotiates the post-quantum group. Curves stay unpinned on
	# purpose: Caddy picks the best the binary supports, which is
	# X25519MLKEM768 on Caddy 2.9+ built with Go 1.24+, X25519 otherwise.
	#
	# The PQ group therefore depends on the BINARY, not this file. To confirm
	# the live server actually negotiates it:
	#   echo | openssl s_client -connect HOST:443 -servername HOST 2>/dev/null \
	#     | grep -i 'Peer Temp Key'
	# X25519MLKEM768 means PQ transport is on; plain X25519 (253 bits) means the
	# Caddy binary is too old, so upgrade it. Needs OpenSSL 3.5+ client-side.
	tls {
		protocols tls1.3
	}

	# HSTS is authoritative here; strip any copy the backend sets so it isn't
	# duplicated (matches nginx's proxy_hide_header Strict-Transport-Security).
	header Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
	header -Server

	# API + WebSocket: opaque reverse proxy to the FastAPI relay. Caddy upgrades
	# /v1/ws transparently and preserves the Origin header the backend checks
	# against MERIDIAN_EDGE_WS_ORIGINS.
	handle /v1/* {
		reverse_proxy {$MERIDIAN_EDGE_BACKEND:server:8000} {
			header_down -Strict-Transport-Security
		}
	}

	# Static client bundle, served same-origin (zero CDN assets). Full page-level
	# CSP lives on these responses only.
	#
	# No try_files, and so no SPA fallback: the client has no router (no
	# pushState, no hash routing, one URL), so rewriting unmatched paths to
	# /index.html rescued no real request and only made every wrong URL answer
	# 200 with the app - including /robots.txt and any mistyped asset hash, which
	# the browser then reports as `Unexpected token '<'` rather than a 404.
	# file_server still serves index.html for the site root on its own.
	handle {
		root * /srv/www
		file_server
		import static_headers
	}

	# Mirrors nginx.conf's `error_page 404 /404.html`. Scoped to 404 so a 502
	# from the backend still surfaces as a 502; `status 404` is needed because
	# the rewrite would otherwise hand back the page with a 200.
	handle_errors 404 {
		root * /srv/www
		rewrite * /404.html
		file_server {
			status 404
		}
		import static_headers
	}
}
